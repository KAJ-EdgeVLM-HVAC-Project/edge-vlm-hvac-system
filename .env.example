# ─────────────────────────────────────────
# .env 파일 설정 가이드
# ─────────────────────────────────────────
#
# 이 파일을 복사하여 .env 파일을 만들고
# 아래 값을 자신의 API 키로 채우세요.
#
# .env 파일은 .gitignore에 등록되어 있어
# GitHub에 업로드되지 않습니다.
#

# 기상청 초단기실황 API 키 (data.go.kr)
# 키가 없어도 기본값(외기 20°C)으로 동작합니다.
WEATHER_API_KEY=YOUR_API_KEY_HERE
